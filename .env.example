# Copy to .env and load it with: node --env-file=.env examples/send.mjs
# Defaults point at the local mock (node test/fixtures/netgsm-sms-mock.mjs --port 4010).
# 8500000000 / password001 is public mock test data, not a real account.
NETGSM_USERNAME=8500000000
NETGSM_PASSWORD=password001
NETGSM_BASE_URL=http://127.0.0.1:4010
NETGSM_SENDER=MOCKTEST
NETGSM_RECIPIENT=905551112201

# Used only by examples/iys-consent.mjs. IYS has no sandbox: against the live API it reads and
# writes the real IYS registry.
NETGSM_IYS_BRAND_CODE=1
# Set to 1 to let the example SAVE a consent record (never do this with test data on live).
NETGSM_IYS_CONFIRM_WRITE=
